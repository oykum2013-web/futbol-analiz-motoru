# football-data.org ücretsiz kayıtlı plan anahtarı (10 istek/dakika)
# Kayıt: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# API-Football ücretsiz plan anahtarı (günde 100 istek) — Sakatlık/Kadro Ajanı için
# Kayıt: https://www.api-football.com/pricing
API_FOOTBALL_KEY=

# The Odds API ücretsiz plan anahtarı (ayda 500 kredi) — Oran/Piyasa Ajanı için
# Kayıt: https://the-odds-api.com/ — kota israfını önlemek için istemci günlük
# (UTC) önbellek kullanır, günde bir kez toplu çekim önerilir.
THE_ODDS_API_KEY=

# api/matches.js (mevcut JS/Vercel uygulaması) için — Vercel proje ayarlarında tanımlanmalı
SPORTDB_API_KEY=
